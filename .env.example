# Copy to .env.local for local development. On Vercel, add both under
# Project Settings → Environment Variables (Production and Preview).

# Clerk publishable key (safe in the browser). Clerk dashboard → API keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Clerk secret key (server only, used by /api functions). Never prefix with VITE_.
CLERK_SECRET_KEY=sk_test_xxx

# Neon Postgres connection string (server only). Neon console -> Connect.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated emails allowed into /admin. Each must be a verified email on a Clerk account.
ADMIN_EMAILS=you@example.com

# Vercel Blob store token (server only): needed for gym photo and video uploads.
# Vercel dashboard -> Storage -> Blob -> your store -> .env.local tab. Never prefix with VITE_.
BLOB_READ_WRITE_TOKEN=
